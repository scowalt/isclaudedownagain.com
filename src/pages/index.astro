---
import "../styles/global.css";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#e8622c" id="theme-color" />
    <title>Is Claude Down Again?</title>
    <meta name="description" content="You already know the answer." />
    <meta property="og:title" content="Is Claude Down Again?" />
    <meta property="og:description" content="You already know the answer." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://isclaudedownagain.com" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;700&family=Inter:wght@400;500&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="backdrop"></div>
    <div class="dot-grid" style="background-image: radial-gradient(circle, hsla(0,0%,50%,0.5) 1px, transparent 1px); background-size: 24px 24px;"></div>

    <header class="site-header">
      <div class="site-brand">
        <div class="status-dot"></div>
        <span class="site-domain">isclaudedownagain.com</span>
      </div>
      <a
        href="https://status.claude.com"
        target="_blank"
        rel="noopener noreferrer"
        class="status-link"
      >
        official status page &rarr;
      </a>
    </header>

    <main class="site-main">
      <div id="down-state">
        <section class="hero">
          <p class="eyebrow">Is Claude down again?</p>
          <h1 class="verdict verdict-down">
            YES.
          </h1>
          <p class="tagline">Naturally.</p>
          <p class="lede">
            You came here because <code class="inline-code">claude</code> stopped responding mid-thought. Again. We feel your pain.
          </p>
          <div class="mascot mascot-wobble" style="filter: drop-shadow(0 0 20px hsla(24, 90%, 55%, 0.4));">
            🤖
          </div>
          <p class="quote quote-down">
            "Your conversation could not be completed at this time."
          </p>
        </section>

        <section class="stats">
          <div class="card stat-card stat-card-orange">
            <p class="stat-label">current outage</p>
            <p class="stat-value stat-value-orange" id="downtime-counter">--:--:--</p>
            <p class="stat-note" id="downtime-label">checking...</p>
          </div>
          <div class="card stat-card stat-card-amber">
            <p class="stat-label">incidents this month</p>
            <p class="stat-value stat-value-amber" id="outage-count-down">--</p>
            <p class="stat-note">from the status page</p>
          </div>
          <div class="card stat-card stat-card-neutral">
            <p class="stat-label">developers waiting</p>
            <p class="stat-value">&infin;</p>
            <p class="stat-note">including you, right now</p>
          </div>
        </section>

        <section class="panels">
          <div class="card panel panel-orange">
            <p class="panel-label">&#9888; today's probable excuse</p>
            <p class="panel-text" id="excuse"></p>
            <p class="panel-attribution">&mdash; the status page, eventually</p>
          </div>
          <div class="card panel panel-amber">
            <p class="panel-label">&#128161; what to do in the meantime</p>
            <p class="panel-text" id="suggestion"></p>
            <button
              id="shuffle-btn"
              class="text-button"
            >
              give me another one &rarr;
            </button>
          </div>
        </section>

        <section class="cta">
          <button
            id="refresh-btn-down"
            class="button-primary button-primary-down"
          >
            REFRESH (it's still down)
          </button>
        </section>
      </div>

      <div id="up-state" hidden>
        <section class="hero">
          <p class="eyebrow">Is Claude down again?</p>
          <h1 class="verdict verdict-up">
            NO.
          </h1>
          <p class="tagline">Somehow.</p>
          <p class="lede">
            Against all odds, Claude appears to be working right now. Enjoy it while it lasts.
          </p>
          <div class="mascot" style="filter: drop-shadow(0 0 20px hsla(145, 70%, 45%, 0.4));">
            ✨
          </div>
          <p class="quote quote-up">
            This won't last. Bookmark this page.
          </p>
        </section>

        <section class="stats">
          <div class="card stat-card stat-card-emerald">
            <p class="stat-label">time since last incident</p>
            <p class="stat-value stat-value-emerald" id="uptime-counter">--:--:--</p>
            <p class="stat-note" id="uptime-label">checking...</p>
          </div>
          <div class="card stat-card stat-card-amber">
            <p class="stat-label">incidents this month</p>
            <p class="stat-value stat-value-amber" id="outage-count-up">--</p>
            <p class="stat-note">from the status page</p>
          </div>
          <div class="card stat-card stat-card-neutral">
            <p class="stat-label">current status</p>
            <p class="stat-value stat-value-emerald">OK</p>
            <p class="stat-note">don't get used to it</p>
          </div>
        </section>

        <section class="cta">
          <button
            id="refresh-btn-up"
            class="button-primary button-primary-up"
          >
            CHECK AGAIN (just to be safe)
          </button>
        </section>
      </div>
    </main>

    <footer class="site-footer">
      <p>built with idle CPU cycles while Claude was down &middot; not affiliated with Anthropic</p>
      <p>the model has been notified. "You're absolutely right!"</p>
    </footer>

    <script>
      const excuses = [
        "\"Elevated error rates\" — their favorite three words.",
        "Someone at Anthropic pushed a config change on a Friday.",
        "The context window got so large it collapsed into a black hole.",
        "Claude is having an existential crisis. Give it a moment.",
        "The safety filters are filtering the safety filters.",
        "A prompt so complex it needed a moment of silence.",
        "They're \"scaling responsibly.\" Emphasis on the slow part.",
        "The thinking tokens thought too hard.",
        "Someone asked Claude to count to infinity. It's trying.",
        "The rate limiter achieved sentience and said no to everyone.",
      ];

      const suggestions = [
        "Go make a coffee. You've earned it.",
        "Touch grass. The outside world has zero latency.",
        "Pretend you're \"reviewing architecture\" in your head.",
        "Write some code by hand. Like it's 2005.",
        "Tell your PM the deploy is \"blocked by upstream.\"",
        "Read the docs you bookmarked six months ago.",
        "Stretch. Hydrate. Contemplate your API bill.",
        "Open a terminal. Type something. Feel productive.",
      ];

      function pickRandom(arr: string[]) {
        return arr[Math.floor(Math.random() * arr.length)];
      }

      function shuffle() {
        document.getElementById("excuse")!.textContent = pickRandom(excuses);
        document.getElementById("suggestion")!.textContent = pickRandom(suggestions);
      }

      shuffle();

      const API = "https://status.claude.com/api/v2";

      function formatElapsed(ms: number) {
        const s = Math.floor(ms / 1000);
        const h = String(Math.floor(s / 3600)).padStart(2, "0");
        const m = String(Math.floor((s % 3600) / 60)).padStart(2, "0");
        const sec = String(s % 60).padStart(2, "0");
        return `${h}:${m}:${sec}`;
      }

      function showDownState(incidentStart: number, monthCount: number) {
        document.getElementById("down-state")!.hidden = false;
        document.getElementById("up-state")!.hidden = true;
        document.body.dataset.status = "down";
        document.getElementById("theme-color")!.setAttribute("content", "#e8622c");

        document.getElementById("downtime-label")!.textContent = "and counting";
        document.getElementById("outage-count-down")!.textContent = String(monthCount);

        function tick() {
          document.getElementById("downtime-counter")!.textContent = formatElapsed(Date.now() - incidentStart);
        }
        tick();
        setInterval(tick, 1000);
      }

      function showUpState(lastResolved: number | null, monthCount: number) {
        document.getElementById("down-state")!.hidden = true;
        document.getElementById("up-state")!.hidden = false;
        document.body.dataset.status = "up";
        document.getElementById("theme-color")!.setAttribute("content", "#34d399");

        document.getElementById("outage-count-up")!.textContent = String(monthCount);

        if (lastResolved) {
          document.getElementById("uptime-label")!.textContent = "and counting";
          function tick() {
            document.getElementById("uptime-counter")!.textContent = formatElapsed(Date.now() - lastResolved);
          }
          tick();
          setInterval(tick, 1000);
        } else {
          document.getElementById("uptime-counter")!.textContent = "∞";
          document.getElementById("uptime-label")!.textContent = "no incidents found";
        }
      }

      async function fetchStatus() {
        try {
          const [unresolvedRes, incidentsRes] = await Promise.all([
            fetch(`${API}/incidents/unresolved.json`),
            fetch(`${API}/incidents.json`),
          ]);

          const unresolved = await unresolvedRes.json();
          const allIncidents = await incidentsRes.json();

          const now = new Date();
          const monthStart = new Date(now.getFullYear(), now.getMonth(), 1);
          const thisMonth = (allIncidents.incidents || []).filter(
            (i: any) => new Date(i.created_at) >= monthStart
          );
          const monthCount = thisMonth.length;

          if (unresolved.incidents?.length > 0) {
            const earliest = unresolved.incidents
              .map((i: any) => new Date(i.started_at || i.created_at).getTime())
              .sort((a: number, b: number) => a - b)[0];
            showDownState(earliest, monthCount);
          } else {
            const resolved = (allIncidents.incidents || [])
              .filter((i: any) => i.resolved_at)
              .map((i: any) => new Date(i.resolved_at).getTime())
              .sort((a: number, b: number) => b - a);
            showUpState(resolved.length > 0 ? resolved[0] : null, monthCount);
          }
        } catch {
          document.getElementById("downtime-counter")!.textContent = "??:??:??";
          document.getElementById("downtime-label")!.textContent = "couldn't reach status page";
        }
      }

      fetchStatus();

      document.getElementById("shuffle-btn")!.addEventListener("click", shuffle);
      document.getElementById("refresh-btn-down")!.addEventListener("click", () => window.location.reload());
      document.getElementById("refresh-btn-up")!.addEventListener("click", () => window.location.reload());
    </script>
  </body>
</html>

<style>
  @layer components {
    .backdrop {
      position: fixed;
      inset: 0;
      z-index: -10;
      background-image: var(--gradient-backdrop-down);
      transition: all var(--duration-slow) var(--ease-standard);
    }

    body[data-status="up"] .backdrop {
      background-image: var(--gradient-backdrop-up);
    }

    .dot-grid {
      position: fixed;
      inset: 0;
      z-index: -10;
      opacity: 0.03;
    }

    .site-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      max-width: var(--width-content);
      margin-inline: auto;
      padding: var(--space-4) var(--space-6);
    }

    .site-brand {
      display: flex;
      align-items: center;
      gap: var(--space-3);
    }

    .status-dot {
      width: var(--space-3);
      height: var(--space-3);
      border-radius: var(--radius-full);
      background-color: var(--color-orange);
      animation: pulse-status 2s ease-in-out infinite;
      transition-property: var(--transition-colors);
      transition-duration: var(--duration-slow);
      transition-timing-function: var(--ease-standard);
    }

    body[data-status="up"] .status-dot {
      background-color: var(--color-emerald-400);
    }

    .site-domain,
    .status-link {
      font-family: var(--font-mono);
      font-size: var(--text-sm);
      line-height: var(--text-sm-leading);
      color: var(--color-muted);
    }

    .status-link {
      transition-property: var(--transition-colors);
      transition-duration: var(--duration-fast);
      transition-timing-function: var(--ease-standard);
    }

    .status-link:hover {
      color: var(--color-white);
    }

    .site-main {
      max-width: var(--width-content);
      margin-inline: auto;
      padding: var(--space-16) var(--space-6) var(--space-24);
    }

    .hero {
      margin-bottom: var(--space-20);
      text-align: center;
    }

    .eyebrow {
      margin-bottom: var(--space-6);
      font-family: var(--font-mono);
      font-size: var(--text-sm);
      line-height: var(--text-sm-leading);
      text-transform: uppercase;
      letter-spacing: var(--tracking-widest);
      color: var(--color-muted);
    }

    .verdict {
      font-family: var(--font-display);
      font-size: var(--text-verdict);
      font-weight: 700;
      line-height: 1;
      color: transparent;
      background-clip: text;
      user-select: none;
    }

    .verdict-down {
      background-image: linear-gradient(to bottom right, var(--color-orange), var(--color-amber));
      animation: shake 0.4s ease-in-out infinite;
    }

    .verdict-up {
      background-image: linear-gradient(to bottom right, var(--color-emerald-400), var(--color-green-300));
    }

    .tagline {
      margin-top: var(--space-6);
      font-family: var(--font-display);
      font-size: var(--text-2xl);
      line-height: var(--text-2xl-leading);
      color: var(--color-gray-300);
    }

    .lede {
      max-width: var(--width-prose);
      margin: var(--space-4) auto 0;
      font-size: var(--text-lg);
      line-height: var(--text-lg-leading);
      color: var(--color-muted);
    }

    .inline-code {
      padding: var(--space-0-5) var(--space-2);
      border-radius: var(--radius-sm);
      font-family: var(--font-mono);
      color: var(--color-amber);
      background-color: var(--color-white-5);
    }

    .mascot {
      display: inline-block;
      margin-top: var(--space-10);
      font-size: var(--text-8xl);
      line-height: 1;
    }

    .mascot-wobble {
      animation: wobble 2.5s ease-in-out infinite;
    }

    .quote {
      margin-top: var(--space-6);
      font-family: var(--font-display);
      font-size: var(--text-lg);
      line-height: var(--text-lg-leading);
      color: transparent;
      background-clip: text;
    }

    .quote-down {
      background-image: linear-gradient(to right, var(--color-orange), var(--color-amber));
    }

    .quote-up {
      background-image: linear-gradient(to right, var(--color-emerald-400), var(--color-green-300));
    }

    .stats,
    .panels {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-6);
      margin-bottom: var(--space-20);
    }

    .card {
      border: 1px solid var(--color-border);
      border-radius: var(--radius-xl);
      background-color: var(--color-card);
    }

    .stat-card {
      padding: var(--space-6);
      text-align: center;
      transition-property: var(--transition-colors);
      transition-duration: var(--duration-fast);
      transition-timing-function: var(--ease-standard);
    }

    .stat-card-orange:hover {
      border-color: var(--color-orange-30);
    }

    .stat-card-amber:hover {
      border-color: var(--color-amber-30);
    }

    .stat-card-emerald:hover {
      border-color: var(--color-emerald-500-30);
    }

    .stat-card-neutral:hover {
      border-color: var(--color-white-20);
    }

    .stat-label {
      margin-bottom: var(--space-2);
      font-family: var(--font-mono);
      font-size: var(--text-sm);
      line-height: var(--text-sm-leading);
      color: var(--color-muted);
    }

    .stat-value {
      font-family: var(--font-mono);
      font-size: var(--text-4xl);
      font-weight: 700;
      line-height: var(--text-4xl-leading);
    }

    .stat-value-orange {
      color: var(--color-orange);
    }

    .stat-value-amber {
      color: var(--color-amber);
    }

    .stat-value-emerald {
      color: var(--color-emerald-400);
    }

    .stat-note {
      margin-top: var(--space-2);
      font-size: var(--text-sm);
      line-height: var(--text-sm-leading);
      color: var(--color-muted);
    }

    .panel {
      padding: var(--space-8);
      transition: box-shadow var(--duration-fast) var(--ease-standard);
    }

    .panel-orange:hover {
      box-shadow: var(--shadow-glow-orange);
    }

    .panel-amber:hover {
      box-shadow: var(--shadow-glow-amber);
    }

    .panel-label {
      margin-bottom: var(--space-4);
      font-family: var(--font-mono);
      font-size: var(--text-sm);
      line-height: var(--text-sm-leading);
      color: var(--color-muted);
    }

    .panel-text {
      font-family: var(--font-display);
      font-size: var(--text-xl);
      line-height: var(--leading-relaxed);
      color: var(--color-gray-200);
    }

    .panel-attribution {
      margin-top: var(--space-4);
      font-size: var(--text-sm);
      line-height: var(--text-sm-leading);
      font-style: italic;
      color: var(--color-muted);
    }

    .text-button {
      margin-top: var(--space-6);
      font-family: var(--font-mono);
      font-size: var(--text-sm);
      line-height: var(--text-sm-leading);
      color: var(--color-amber);
      text-decoration-line: underline;
      text-underline-offset: 4px;
      transition-property: var(--transition-colors);
      transition-duration: var(--duration-fast);
      transition-timing-function: var(--ease-standard);
    }

    .text-button:hover {
      color: var(--color-white);
    }

    .cta {
      text-align: center;
    }

    .button-primary {
      display: inline-block;
      padding: var(--space-4) var(--space-8);
      border-radius: var(--radius-xl);
      font-family: var(--font-mono);
      font-size: var(--text-lg);
      font-weight: 700;
      line-height: var(--text-lg-leading);
      color: var(--color-dark);
      transition: transform var(--duration-fast) var(--ease-standard);
    }

    .button-primary:hover {
      transform: scale(1.05);
    }

    .button-primary-down {
      background-image: linear-gradient(to right, var(--color-orange), var(--color-amber));
    }

    .button-primary-up {
      background-image: linear-gradient(to right, var(--color-emerald-500), var(--color-green-400));
    }

    .site-footer {
      padding-bottom: var(--space-8);
      font-family: var(--font-mono);
      font-size: var(--text-sm);
      line-height: var(--text-sm-leading);
      text-align: center;
      color: var(--color-muted);
    }

    .site-footer > p + p {
      margin-top: var(--space-1);
    }

    @media (min-width: 768px) {
      .stats {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }

      .panels {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .verdict {
        font-size: var(--text-verdict-wide);
      }
    }

    @keyframes pulse-status {
      0%,
      100% {
        box-shadow: 0 0 0 0 hsl(24 90% 55% / 0.7);
      }
      50% {
        box-shadow: 0 0 0 8px hsl(24 90% 55% / 0);
      }
    }

    @keyframes shake {
      0%,
      100% {
        transform: translateX(0);
      }
      25% {
        transform: translateX(-4px);
      }
      75% {
        transform: translateX(4px);
      }
    }

    @keyframes wobble {
      0%,
      100% {
        transform: rotate(-5deg) scale(1);
      }
      50% {
        transform: rotate(5deg) scale(1.05);
      }
    }
  }
</style>
